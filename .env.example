# =============================================================================
# SanaIA — Variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA commitees .env.local al repositorio.
# =============================================================================

# --- Supabase (Dev 1: Auth & Database) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Solo server-side — operaciones privilegiadas (RLS bypass)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Agente Zavu (Dev 3: Orquestación del agente) ---
ZAVU_API_KEY=your-zavu-api-key
ZAVU_BASE_URL=https://api.zavu.ai/v1

# --- Wallbit — Billetera de Emergencias (Dev 2) ---
WALLBIT_API_KEY=your-wallbit-api-key
WALLBIT_BASE_URL=https://api.wallbit.io/v1

# --- Voz: ElevenLabs + Whisper (Dev 3) ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key
OPENAI_API_KEY=your-openai-api-key

# --- Búsqueda y scraping (Dev 4) ---
FIRECRAWL_API_KEY=your-firecrawl-api-key
EXA_API_KEY=your-exa-api-key

# --- Resúmenes visuales (Dev 4) ---
FAL_API_KEY=your-fal-api-key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
